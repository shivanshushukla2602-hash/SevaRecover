# AWS Credentials & Bedrock Region Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Amazon Bedrock Model ID (e.g., anthropic.claude-3-5-sonnet-20240620-v1:0 or amazon.titan-text-express-v1)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Amazon OpenSearch Configuration (Local Docker or AWS OpenSearch Domain)
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX=sevarecover-kb
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
